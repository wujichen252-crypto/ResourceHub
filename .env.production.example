# ResourceHub 生产环境配置
# 复制为 .env 并修改 SECRET_KEY！

# JWT 密钥 — 必须修改！生成方式：
# docker run --rm python:3.10-slim python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-please-change-this-in-production

# 服务器公网 IP（让前端 CORS 允许你的 IP 访问）
SERVER_IP=your-server-ip

# 域名（如果有）
DOMAIN=your-domain.com

# AI 能力层（密钥仅存服务器，禁止入库）
# 当前使用硅基流动：对话与向量同一服务商，OpenAI 兼容协议
AI_BASE_URL=https://api.siliconflow.cn/v1
AI_API_KEY=填入硅基流动密钥
AI_CHAT_MODEL=zai-org/GLM-5.3-Flash
AI_FAST_MODEL=zai-org/GLM-5.3-Flash
# 向量服务可单独配置，留空复用上面的配置
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=BAAI/bge-m3
AI_EMBEDDING_DIM=1024
AI_EMBEDDING_BATCH_SIZE=16
AI_REQUEST_TIMEOUT=60
AI_MAX_OUTPUT_TOKENS=2048
AI_AGENT_MAX_STEPS=6
AI_DAILY_TOKEN_QUOTA=500000

# ── 智能体身份层：长期记忆、人格与主动性 ──
AI_MEMORY_EXTRACT_ENABLED=true
AI_MEMORY_MAX_PER_USER=200
AI_MEMORY_TOP_K=5
AI_MEMORY_MIN_MESSAGES=4
AI_MEMORY_DEDUP_SCORE=0.9
AI_PROACTIVE_ENABLED=true
AI_PROACTIVE_HOUR=8
AI_PROACTIVE_TIMEZONE=Asia/Shanghai
AI_STALE_GOAL_DAYS=30

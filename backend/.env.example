# ResourceHub 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# 应用环境: development / production
ENV=development

# 调试模式 (生产环境请设为 false)
DEBUG=true

# 数据库连接地址（当前使用远端 MySQL，注意库名是小写 resourcehub）
# MySQL 示例: mysql+aiomysql://user:password@host:3306/dbname?charset=utf8mb4
# SQLite 示例: sqlite+aiosqlite:///./resourcehub.db
DATABASE_URL=mysql+aiomysql://user:password@host:3306/resourcehub?charset=utf8mb4

# JWT 密钥 (生产环境必须修改为强随机字符串)
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-in-production

# Access Token 过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Refresh Token 过期时间（天）
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS 允许的源（list 类型必须写成 JSON 数组，逗号分隔会报解析错误）
CORS_ORIGINS=["http://localhost:5173","http://localhost:80"]

# ── AI 能力层（OpenAI 兼容协议，可切换 DeepSeek / 智谱 / 通义 / OpenAI）──
# 密钥只放后端，禁止写入前端或提交到仓库
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_CHAT_MODEL=deepseek-chat
AI_FAST_MODEL=deepseek-chat
# 向量服务，留空则复用 AI_BASE_URL / AI_API_KEY（智谱为 https://open.bigmodel.cn/api/paas/v4）
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=embedding-3
AI_EMBEDDING_DIM=2048
AI_REQUEST_TIMEOUT=60
AI_MAX_OUTPUT_TOKENS=2048
AI_AGENT_MAX_STEPS=6
# 单用户每日 token 上限，0 表示不限制（演示环境建议保留）
AI_DAILY_TOKEN_QUOTA=500000
AI_CHUNK_SIZE=700
AI_CHUNK_OVERLAP=100

# ── 智能体身份层：长期记忆、人格与主动性 ──
AI_MEMORY_EXTRACT_ENABLED=true
AI_MEMORY_MAX_PER_USER=200
AI_MEMORY_TOP_K=5
AI_MEMORY_MIN_MESSAGES=4
AI_MEMORY_DEDUP_SCORE=0.9
AI_PROACTIVE_ENABLED=true
AI_PROACTIVE_HOUR=8
AI_PROACTIVE_TIMEZONE=Asia/Shanghai
AI_STALE_GOAL_DAYS=30

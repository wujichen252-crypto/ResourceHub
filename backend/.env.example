# ResourceHub 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改

# 应用环境: development / production
ENV=development

# 调试模式 (生产环境请设为 false)
DEBUG=true

# 数据库连接地址
# SQLite 示例: sqlite+aiosqlite:///./resourcehub.db
# PostgreSQL 示例: postgresql+asyncpg://user:password@localhost:5432/resourcehub
DATABASE_URL=sqlite+aiosqlite:///./resourcehub.db

# JWT 密钥 (生产环境必须修改为强随机字符串)
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-in-production

# Access Token 过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Refresh Token 过期时间（天）
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS 允许的源，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:80
